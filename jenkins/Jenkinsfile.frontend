pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        REPO_DIR = "/opt/after7/repository"
    }

    stages {

        stage("Checkout") {

            steps {

                sh """
                    set -e

                    cd ${REPO_DIR}

                    git fetch origin

                    git checkout main

                    git reset --hard origin/main
                """
            }
        }


        stage("Deploy Frontend") {

            steps {

                sh """
                    chmod +x \
                        ${REPO_DIR}/jenkins/scripts/deploy-frontend.sh

                    ${REPO_DIR}/jenkins/scripts/deploy-frontend.sh
                """
            }
        }


        stage("Health Check") {

            steps {

                sh """
                    chmod +x \
                        ${REPO_DIR}/jenkins/scripts/health-check.sh

                    ${REPO_DIR}/jenkins/scripts/health-check.sh
                """
            }
        }
    }
}