{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "types": ["node", "vitest/globals"]
  },

  "include": ["tests/**/*.ts"],

  "exclude": ["node_modules", "Server", "Client"]
}
